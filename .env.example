# ==========================================
# n8n AI Invoice Processing Pipeline Environment
# ==========================================

# Google Gemini Vision API (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
N8N_WEBHOOK_URL=http://localhost:5678/webhook/process-invoice

# n8n Core Settings
N8N_PORT=5678
N8N_ENCRYPTION_KEY=super-secret-encryption-key-change-me-32chars
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# PostgreSQL Database Configuration
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=n8n_secure_password_123
POSTGRES_DB=invoice_automation_db
POSTGRES_PORT=5432

# Alerting & Human-In-The-Loop Webhook / Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
NOTIFICATION_EMAIL=finance-approvals@yourcompany.com

